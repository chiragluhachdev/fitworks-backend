{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",

    "module": "node16",
    "target": "ES2020",
    "types": ["node"],
    "lib": ["ES2020"],

    "sourceMap": true,
    "declaration": true,

    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "moduleResolution": "node16"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "seed.ts"]
}
